# Kanerva's sparse distributed memory: 256-bit words, 2000 hard locations.
# Each hard location has a fixed random address (from the name and the seed); a write adds the word to the
# bit-counters of every hard location within the activation radius of it, and a read sums those counters.
model :mind do
  sdm :s, word-size: 256, hard-locations: 2000          # activation radius defaults to 112: about 2% of hard locations wake
  s.write :cat
  s.write :dog
  s.write :owl
  s.write :note, "meet at nine"
  s.write :diary, "under the mat", key: "blue heron"   # turned by the key; the text is held nowhere
end

run :mind do
  s.read read-address: :cat, address-noise: 0.2, seed: 1      # Kanerva's read, iterated to a fixed point
  s.read read-address: :note, address-noise: 0.15, seed: 2    # the text comes back
  s.read read-address: :owl, address-noise: 0.4, seed: 3      # 40% of the bits flipped; with five words stored it still comes back
  s.read seed: 4                                              # pure noise wakes random hard locations
  s.read read-address: :zebra, address-noise: 0.0, seed: 5    # never written, so it is not recalled
  s.read key: "blue heron"                                    # the right key finds and reads the note
  s.read key: "red heron"                                     # a wrong key reads nothing
end
